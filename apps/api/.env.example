# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://phygital:phygital@localhost:5432/phygital?schema=public"
# Public URLs (used for redirects, QR passports and webhooks)
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (defaults to WEB_URL)
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Auth & wallets
#   AUTH_MODE=dev   -> trust the `x-demo-email` header (local development only!)
#   AUTH_MODE=privy -> verify Privy access tokens (social login + embedded wallets)
# ---------------------------------------------------------------------------
AUTH_MODE=dev
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Emails that are always treated as admins (store managers)
ADMIN_EMAILS=admin@phygital.dev

# ---------------------------------------------------------------------------
# Web3 (Digital Twin minting + on-chain loyalty)
# ---------------------------------------------------------------------------
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Backend hot wallet holding MINTER_ROLE. Hardhat account #0 shown here — NEVER use it on a real network.
MINTER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
TWIN_CONTRACT_ADDRESS=
MINT_CONFIRMATIONS=1
MINT_MAX_ATTEMPTS=8
MINT_WORKER_INTERVAL_MS=10000

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Instant "demo" payments (never enable in production)
ENABLE_MOCK_PAYMENTS=true

# Stripe (cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (LatAm)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=ARS
# Store prices are in USD; this rate converts them to MERCADOPAGO_CURRENCY
MERCADOPAGO_FX_RATE=1

# Crypto (USDC / any 6-decimal ERC-20 on CHAIN_ID)
USDC_TOKEN_ADDRESS=
MERCHANT_WALLET_ADDRESS=
CRYPTO_MIN_CONFIRMATIONS=1

# ---------------------------------------------------------------------------
# AI concierge — provider is auto-detected from whichever key is set.
# Without a key the concierge uses a deterministic rule-based recommender.
# ---------------------------------------------------------------------------
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
