# Private key of the deployer. It is granted DEFAULT_ADMIN_ROLE and MINTER_ROLE.
DEPLOYER_PRIVATE_KEY=
# Optional: separate backend minter address to grant MINTER_ROLE (recommended in production).
MINTER_ADDRESS=
# Metadata base URI ({id} is replaced client-side per ERC-1155), e.g. https://api.example.com/api/twins/{id}.json
TWIN_METADATA_URI=http://localhost:4000/api/twins/{id}.json
# Deploy a MockUSDC token for local crypto checkout testing (localhost/hardhat only)
DEPLOY_MOCK_USDC=true

# RPCs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
